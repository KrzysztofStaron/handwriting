# keep the build context (and image) tiny — the Dockerfile COPYs app_np.py,
# model_np.py, weights.npz, stoi.json, and std.json; everything else is noise.
.venv/
__pycache__/
*.pyc
.git/
.gitignore

# dataset — never goes in the image (std is baked into std.json)
data/

# training / dev-only + torch serving code (numpy image uses app_np.py + model_np.py)
train.py
data.py
model.py
generate.py
app.py
export_weights.py

# checkpoints — the numpy image serves from weights.npz, not any .pth
*.pth
samples/

# generated artifacts / docs / tooling
*.png
*.pdf
*.md
uv.lock
pyproject.toml
vocab.txt
vocab.json
